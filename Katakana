<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>Katakana 46 Audio</title>

<style>
body{
  margin:0;
  padding:0;
  font-family: Arial, sans-serif;
  background:#4195a5;
  color:white;
  overflow-x:hidden;
}

h1{
  text-align:center;
  padding:20px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(90px,1fr));
  gap:15px;
  padding:20px;
}

.card{
  background:#ffcc80;
  color:#000;
  padding:18px 8px;
  border-radius:12px;
  text-align:center;
  cursor:pointer;
  font-size:28px;
  font-weight:bold;
}

.info{
  font-size:13px;
  margin-top:6px;
  display:none;
}

/* FOOTER */
.footer{
  width:100%;
  background:linear-gradient(135deg,#f5c16c,#4195a5);
  padding:40px 10px;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
  box-shadow:0 -6px 18px rgba(0,0,0,0.45);
}

.footer-content{
  max-width:700px;
}

.footer-content .created{
  font-size:13px;
  color:#fff4dc;
  letter-spacing:2px;
  margin:0;
}

.footer-content h2{
  margin:12px 0;
  font-size:24px;
  color:#ffffff;
  letter-spacing:1.5px;
}

.footer-content .title{
  font-size:14px;
  color:#ffffff;
  line-height:1.7;
  margin:0;
}

.footer-content span{
  color:#ffe08a;
  font-weight:bold;
}
</style>
</head>

<body>

<h1>Katakana 46 🔊 (Japanese Audio)</h1>


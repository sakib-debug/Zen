<script>
function play(card,jp){
  const info = card.querySelector(".info");
  info.style.display = info.style.display==="block"?"none":"block";

  const u = new SpeechSynthesisUtterance(jp);
  u.lang="ja-JP";
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}
</script>


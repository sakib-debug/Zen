<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZEN N5 Kanji Learning System</title>

<!-- Hanzi Writer -->
<script src="https://cdn.jsdelivr.net/npm/hanzi-writer@2.0/dist/hanzi-writer.min.js"></script>

<style>
body{
    margin:0;
    font-family:Segoe UI,sans-serif;
    background:#4195a5;
    color:white;
}

header{
    background:linear-gradient(135deg,#4d0d0d,#4195a5);
    padding:20px;
    text-align:center;
}

header h1{
    margin:0;
    font-size:28px;
}

header p{
    margin:5px 0;
}

.main{
    display:flex;
    height:calc(100vh - 170px);
}

/* LEFT SIDE */
.left{
    width:50%;
    overflow-y:auto;
    padding:15px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(70px,1fr));
    gap:10px;
}

.box{
    background:#f5c16c;
    color:black;
    font-size:24px;
    padding:12px;
    border-radius:8px;
    text-align:center;
    cursor:pointer;
    font-weight:bold;
    transition:.3s;
}

.box:hover{
    transform:scale(1.08);
    background:#ffd98d;
}

/* RIGHT PANEL */
.right{
    width:50%;
    background:rgba(7, 7, 7, 0.95);
    color:rgb(246, 244, 244);
    padding:25px;
    box-sizing:border-box;
    overflow-y:auto;
    backdrop-filter:blur(10px);
}

/* BIG KANJI */
#kanjiChar{
    font-size:90px;
    margin:0;
    color:#4195a5;
    font-weight:bold;
    text-shadow:0 4px 10px rgba(0,0,0,0.08);
}

/* PREMIUM BOX STROKE AREA */
#strokeArea{
    width:320px;
    height:320px;
    margin:25px auto;
    background:linear-gradient(145deg,#ce800c,#ce800c);
    border-radius:22px;   /* box with soft corners */
    border:4px dashed rgba(25, 120, 5, 0.8);

    box-shadow:
        inset 0 8px 18px rgba(255,255,255,0.9),
        inset 0 -8px 18px rgba(0,0,0,0.05),
        0 15px 35px rgba(0,0,0,0.18);

    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    transition:all .35s ease;
}

/* Hover effect */
#strokeArea:hover{
    transform:translateY(-5px) scale(1.03);
    box-shadow:
        inset 0 8px 18px rgba(255,255,255,0.9),
        inset 0 -8px 18px rgba(0,0,0,0.05),
        0 22px 45px rgba(0,0,0,0.22);
}

/* TEXT STYLE */
.infoText{
    font-size:22px;
    margin:10px 0;
    font-weight:600;
}

/* PREMIUM BUTTON */
button{
    padding:14px 28px;
    background:linear-gradient(135deg,#4195a5,#2f7d8b);
    color:white;
    border:none;
    border-radius:40px;
    cursor:pointer;
    margin-top:15px;
    font-size:18px;
    font-weight:bold;
    box-shadow:0 10px 20px rgba(0,0,0,0.18);
    transition:.3s;
}

button:hover{
    transform:translateY(-3px);
    box-shadow:0 14px 28px rgba(0,0,0,0.22);
}

/* MOBILE */
@media(max-width:900px){
.right{
    width:100%;
}

#strokeArea{
    width:260px;
    height:260px;
}

#kanjiChar{
    font-size:75px;
}
}}
}footer{
    background:linear-gradient(135deg,#f5c16c,#4195a5);
    padding:15px;
    text-align:center;
}

@media(max-width:900px){
.main{
    flex-direction:column;
    height:auto;
}
.left,.right{
    width:100%;
}
}
</style>
</head>

<body>

<header>
<h1>ZEN Japanese Education Consultancy</h1>
<p>Created By: MD NAZMUS SAKIB</p>
<p>JLPT N5 Complete Kanji System</p>
</header>

<div class="main">

<!-- LEFT -->
<div class="left">
<div class="grid" id="kanjiGrid"></div>
</div>

<!-- RIGHT -->
<div class="right">
<center>
<h1 id="kanjiChar">日</h1>

<div id="strokeArea"></div>

<p class="infoText" id="meaningEn">English: Day / Sun</p>
<p class="infoText" id="meaningBn">বাংলা: দিন / সূর্য</p>
<p class="infoText" id="pronounce">উচ্চারণ: নি / হিচি</p>

<button onclick="playAudio()">🔊 Slow Voice</button>
</center>
</div>

</div>

<footer>
© 2026 ZEN Japanese Education Consultancy
</footer>


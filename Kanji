const grid = document.getElementById("kanjiGrid");
let currentKanji="日";

kanjiData.forEach(item=>{
    const div=document.createElement("div");
    div.className="box";
    div.innerText=item.k;

    div.onclick=()=>{
        currentKanji=item.k;

        document.getElementById("kanjiChar").innerText=item.k;
        document.getElementById("meaningEn").innerText="English: "+item.en;
        document.getElementById("meaningBn").innerText="বাংলা: "+item.bn;
        document.getElementById("pronounce").innerText="উচ্চারণ: "+item.pr;

        document.getElementById("strokeArea").innerHTML="";

        HanziWriter.create("strokeArea", item.k,{
            width:260,
            height:260,
            padding:5,
            strokeAnimationSpeed:0.4,
            delayBetweenStrokes:400,
            showOutline:true
        }).animateCharacter();
    };

    grid.appendChild(div);
});

function playAudio(){
    const msg = new SpeechSynthesisUtterance(currentKanji);
    msg.lang="ja-JP";
    msg.rate=0.45;
    msg.pitch=1;
    speechSynthesis.cancel();
    speechSynthesis.speak(msg);
}

/* default load */
grid.children[13].click();

